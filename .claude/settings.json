{
  "permissions": {
    "allow": [
      "Bash(find:*)",
      "Bash(npm run:*)",
      "Bash(pnpm *)",
      "Bash(composer *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-lint.sh"
          }
        ]
      }
    ]
  }
}
