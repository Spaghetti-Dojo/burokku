{
	"permissions": {
		"allow": [
			"Bash(find:*)",
			"Bash(npm run:*)",
			"Bash(pnpm *)",
			"Bash(composer *)",
			"Bash(./vendor/bin/phpcs:*)"
		]
	},
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "SessionEnd",
				"hooks": [
					{
						"type": "command",
						"command": "bash .claude/hooks/linting.sh"
					}
				]
			}
		]
	}
}
