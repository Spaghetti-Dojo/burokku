<?xml version="1.0"?>
<ruleset name="Burokku">
	<description>PHP Coding Standards for Burokku Theme</description>

	<file>./inc/</file>
	<file>./sources/</file>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="Syde"/>

	<!--
		Syde enforces camelCase for variable names, but WordPress convention uses snake_case.
		Prefer WordPress naming conventions for variables.
	-->
	<rule ref="Syde.NamingConventions.VariableName">
		<exclude name="Syde.NamingConventions.VariableName.SnakeCaseVar"/>
	</rule>
</ruleset>
