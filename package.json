{
	"name": "burokku",
	"version": "1.0.0",
	"description": "A modern WordPress Block Theme inspired by shadcn/ui design system",
	"author": "guido scialfa <dev@guidoscialfa.com>",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"block-theme",
		"shadcn-ui",
		"accessibility",
		"design-system"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/Spaghetti-Dojo/burokku.git"
	},
	"bugs": {
		"url": "https://github.com/Spaghetti-Dojo/burokku/issues"
	},
	"homepage": "https://github.com/Spaghetti-Dojo/burokku#readme",
	"engines": {
		"node": ">=24.0.0",
		"pnpm": ">=10.0.0"
	},
	"dependencies": {
		"@wordpress/block-editor": "^15.12.0",
		"@wordpress/blocks": "^15.12.0",
		"@wordpress/components": "^32.1.0",
		"@wordpress/i18n": "^6.12.0",
		"@wordpress/server-side-render": "^6.24.0",
		"aos": "^2.3.4"
	},
	"devDependencies": {
		"@types/aos": "^3.0.7",
		"@types/node": "^24.0.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@types/webpack": "^5.28.5",
		"@wordpress/data": "^10.48.0",
		"@wordpress/editor": "^14.48.0",
		"@wordpress/element": "^8.0.0",
		"@wordpress/env": "^10.39.0",
		"@wordpress/keyboard-shortcuts": "^5.48.0",
		"@wordpress/plugins": "^7.48.0",
		"@wordpress/prettier-config": "^4.39.0",
		"@wordpress/scripts": "^31.4.0",
		"clean-webpack-plugin": "^4.0.0",
		"dotenv-cli": "^8.0.0",
		"sass": "^1.83.0",
		"stylelint-plugin-logical-css": "^2.0.2",
		"ts-node": "^10.9.2",
		"typescript": "~5.9.0"
	},
	"scripts": {
		"env": "wp-env",
		"shell": "wp-env run cli wp shell",
		"start": "dotenv -- wp-scripts start",
		"build": "dotenv -- wp-scripts build && pnpm build:color-scheme",
		"build:color-scheme": "node tools/color-scheme/build.mjs",
		"build:color-scheme:check": "node tools/color-scheme/build.mjs --check",
		"build:dev:scripts": "wp-scripts start --webpack--devtool=inline-source-map",
		"build:dev:modules": "dotenv -- wp-scripts start --config webpack.modules.config.js --webpack--devtool=inline-source-map",
		"build:manifest": "wp-scripts build-blocks-manifest --input=sources/blocks --output=dist/modules/blocks/blocks-manifest.php",
		"lint:styles": "wp-scripts lint-style",
		"lint:styles:fix": "wp-scripts lint-style --fix",
		"lint:scripts": "wp-scripts lint-js",
		"lint:scripts:fix": "wp-scripts lint-js --fix",
		"test:color-scheme": "node --test tools/color-scheme/*.test.mjs",
		"format": "wp-scripts format"
	}
}
